[Unit]
Description=Ship Analysis dashboard aggregate API
After=ship-analysis-collector.service

[Service]
Type=simple
User=shipanalysis
Group=shipanalysis
WorkingDirectory=/opt/ship_analysis/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ship_analysis/app/.venv/bin/ship-analysis --config /opt/ship_analysis/app/config/regions.toml dashboard-api --host 127.0.0.1 --port 8765
Restart=always
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ship_analysis/app/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
